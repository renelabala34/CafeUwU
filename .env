# ============================================
# CONFIGURACIÓN DE SUPABASE PARA I'MAS
# ============================================
# Instrucciones:
# 1. Ve a https://app.supabase.com
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Ve a Settings > API
# 4. Copia los valores y reemplaza abajo
# ============================================

# URL de tu proyecto Supabase (ej: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (anon/public key) de tu proyecto
# La encuentras en Settings > API > Project access keys
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ============================================
# IMPORTANTE: Después de configurar esto:
# 1. Ejecuta el script setup-images.sql en el SQL Editor de Supabase
# 2. Reinicia tu aplicación (npm run dev)
# ============================================
