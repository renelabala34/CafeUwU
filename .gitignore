# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Testing
*.test.js
*.spec.js
test-results/

