```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
yarn.lock
package-lock.json

# Build outputs
dist/
build/
.next/
.nuxt/
out/
public/build/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/
istanbul/
```